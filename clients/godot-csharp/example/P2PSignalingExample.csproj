<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>P2PSignalingExample</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Compile the library's sources INTO the game assembly, exactly as a real game does. Do not use a ProjectReference
      to P2PSignaling.csproj: Godot only runs script classes (and their _Process) from the game's own assembly, so a
      separately compiled P2PLobby connects to nothing and fails silently. See docs/integration-guide.md.
    -->
    <Compile Include="..\src\**\*.cs" />
  </ItemGroup>
</Project>
